# "production" on the host (npm start in the project folder sets it): serves
# the built client, marks the cookie Secure and checks the settings below.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# The site's public address. In production (one service) that is the
# server's own address, e.g. https://voiceloop.onrender.com. Required there.
CLIENT_URL=http://localhost:5173
# Production behind a host's proxy (Render, Railway, Fly...): 1. Off locally.
TRUST_PROXY=
# Optional, production only: folder of the built client (default client/dist).
CLIENT_DIST_DIR=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<replace-with-a-long-random-string>
# Optional. "lax" (default) when client and API share a site; see docs/ARCHITECTURE.md.
COOKIE_SAMESITE=lax
# Optional. Database for `npm test`; its name must end in _test. If unset, tests
# use the MONGODB_URI cluster with a database named voiceloop_test.
MONGODB_TEST_URI=
# Private audio storage. "local" (default) keeps files in server/private-storage,
# which is gitignored and never served directly. "s3" uses an S3-compatible
# private bucket (AWS S3, Cloudflare R2, Backblaze B2); the server refuses to
# start if one of the required S3_* values below is missing.
STORAGE_DRIVER=local
# Optional. Another folder for the local driver; keep it outside any public path.
STORAGE_LOCAL_DIR=
# Only read when STORAGE_DRIVER=s3. For Cloudflare R2: S3_ENDPOINT is
# https://<account id>.r2.cloudflarestorage.com and S3_REGION is auto.
# Leave S3_ENDPOINT empty for AWS S3. The two keys are secret.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: true/false. Defaults to true when S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE=
# Speech-to-text. Only "none" exists: voice feedback is stored with
# transcriptStatus "unavailable" and no external service is called.
TRANSCRIPTION_PROVIDER=none
# Feedback (with its notes and recording) is deleted automatically this many
# days after it was submitted, whatever its status. Whole number, 1 to 3650.
RETENTION_DAYS=45
# Outgoing email (password reset links). "console" (default) prints emails,
# links included, to this server's log instead of sending them. That is for
# development: with NODE_ENV=production it sends nothing (the server starts
# with a warning; use the Super Admin's Reset link instead). "resend" sends
# through Resend (https://resend.com) and needs both values below.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. VoiceLoop <no-reply@yourdomain.com>.
# onboarding@resend.dev works for testing, but only delivers to your own address.
EMAIL_FROM=
