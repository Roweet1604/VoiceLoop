# Leave empty to call the API on the same origin (/api). In development the
# Vite dev server proxies /api to API_PROXY_TARGET. Set this only if a deployed
# client must call an API on a different origin.
VITE_API_URL=

# Dev-server only (not exposed to the browser): where Vite forwards /api.
API_PROXY_TARGET=http://localhost:5000
